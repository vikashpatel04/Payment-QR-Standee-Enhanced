{
  "name": "counter-pay",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Windows app that shows a fixed-amount UPI QR on a customer-facing display.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @counterpay/display --filter @counterpay/agent dev",
    "build": "pnpm --filter @counterpay/display build && pnpm --filter @counterpay/agent build",
    "dist": "pnpm --filter @counterpay/agent dist",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
